#!/bin/bash

_@command@_autocompletion_generate_options() {

}

_@command@_autocompletion (){
    local previous current

    if [[ $COMP_CWORD -gt 0 ]]; then
	current="${COMP_WORDS[-1]}"

	if [[ $COMP_CWORD -gt 1 ]]; then
	    previous="${COMP_WORDS[-2]}"
	fi
    fi

    case "$previous" in
	*)
	    options=$(_@command@_autocompletion_generate_options ${COMP_WORDS[@@]})
	    COMPREPLY=($(compgen -W "$options" -- "$current"));;
    esac
}

complete -F _@command@_autocompletion @command@
