#: src/gengetopt.cc:124
#, c-format
msgid "Run gengetopt --help to see the list of options.\n"
msgstr "Executez « gengetopt --help » pour afficher la liste des options.\n"

#: src/gengetopt.cc:155
#, c-format
msgid "Error opening input file: %s\n"
msgstr "Erreur lors de l'ouverture du fichier d'entrée : %s\n"

#: src/gengetopt.cc:173
#, c-format
msgid "Error in the args specification of the input_file.\n"
msgstr "Erreur dans les arguments renseignés dans le fichier d'entrée.\n"

#: src/gengetopt.cc:299
msgid "package not defined; please specify it with --set-package"
msgstr "« package » non définit ; merci de renseigner --set-package"

#: src/gengetopt.cc:304
msgid "version not defined; please specify it with --set-version"
msgstr "version non définie ; merci de renseigner --set-version"

#: src/gengetopt.cc:321
msgid "Usage: "
msgstr "Usage : "

#: src/gengetopt.cc:884
msgid "option depends on itself"
msgstr "l'option dépend d'elle-même"

#: src/gengetopt.cc:900
msgid "option depends on undefined option"
msgstr "l'option dépend d'une option non définie"

#: src/gengetopt.cc:935
#, c-format
msgid "gengetopt: not enough memory to canonize vars\n"
msgstr "gengetopt : pas assez de mémoire pour canoniser les variables\n"

#: src/gengetopt.cc:976
msgid "Maintained by Tomas Volf <wolf@wolfsden.cz>"
msgstr "Maintenu par Tomas Wolf <wolf@wolfsden.cz>"

#: src/gengetopt.cc:977
msgid "Report bugs to <bug-gengetopt@gnu.org>"
msgstr "Signaler les bogue à <bug-gengetopt@gnu.org>"
